+	// The number of bytes left in the reader. `Read` has no size, but every
+	// implementation can seek to the end and back, and the chunk callbacks below
+	// are handed a reader that is not bounded to their own chunk -- so this is
+	// the only ceiling a file-supplied count can be checked against.
+	static std::size_t _bytes_remaining(Read* r) {
+		auto here = r->tell();
+		r->seek(0, Whence::END);
+		auto end = r->tell();
+		r->seek(static_cast<ssize_t>(here), Whence::BEG);
+		return end > here ? end - here : 0;
+	}
