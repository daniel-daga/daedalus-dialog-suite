+	/// \brief Formats a float the way the original ZenGin did.
+	///
+	/// ZenGin built the `texScale` and `texAniMapDir` strings with its MSVC 6 CRT, which
+	/// used eight significant digits and always printed at least three exponent digits
+	/// (`9.9999997e-005`). Modern CRTs print two (`9.9999997e-05`), and ZenKit asked for
+	/// nine digits on top of that, so every material chunk came out a few bytes longer
+	/// than the original with no change in value.
+	static std::string format_float_legacy(float value) {
+		char buf[64];
+		std::snprintf(buf, sizeof buf, "%.8g", static_cast<double>(value));
+
+		std::string out {buf};
+		auto e = out.find('e');
+		if (e != std::string::npos && out.size() - e == 4) {
+			out.insert(e + 2, 1, '0');
+		}
+		return out;
+	}
+
+	static std::string format_vec2_legacy(Vec2 const& v) {
+		return format_float_legacy(v.x) + " " + format_float_legacy(v.y);
+	}
+
 	Material Material::parse(ReadArchive& in) {
