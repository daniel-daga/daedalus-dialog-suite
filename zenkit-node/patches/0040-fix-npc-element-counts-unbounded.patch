 #include <algorithm>
 
 namespace zenkit {
+	// The number of bytes left in the reader, as in `Mesh.cc`, `BspTree.cc` and
+	// `WayNet.cc`: `Read` exposes no size, but every implementation can seek to
+	// the end and back. It is a ceiling, not the exact room left -- in a BinSafe
+	// archive the hash table still follows the entry stream -- which is all a
+	// sanity bound needs.
+	static std::size_t _bytes_remaining(Read* r) {
+		auto here = r->tell();
+		r->seek(0, Whence::END);
+		auto end = r->tell();
+		r->seek(static_cast<ssize_t>(here), Whence::BEG);
+		return end > here ? end - here : 0;
+	}
+
+	// The smallest an archived object can be in any of the three formats, as in
+	// `WayNet.cc`: a type byte and a two-byte length in BinSafe, a `[% % 0 0]`
+	// line in ASCII. Four is under all of them, which is what a bound wants -- it
+	// must never refuse a world the engine loads.
+	static constexpr std::size_t OBJECT_MIN_BYTES = 4;
 	void VAnimate::parse(VAnimate& obj, ReadArchive& r, GameVersion version) {
 		obj.load(r, version);
 	}
