+	/// \brief Formats a float the way ZenGin's ASCII archiver did.
+	///
+	/// Nine significant digits, trailing zeros stripped, and the three exponent
+	/// digits ZenGin's MSVC CRT always printed (`2.98023224e-008`; modern CRTs
+	/// print two). `std::to_string` is `%f` - six decimals, always - which both
+	/// pads every round value (`0` became `0.000000`) and *loses* digits at
+	/// world magnitudes (`1511.77087` became `1511.770874`) and below
+	/// (`2.98023224e-008` became `0.000000`). Byte fidelity only: nine digits
+	/// round-trips a float exactly, so no parsed value changes.
+	static std::string ftosv(float v) {
+		char buf[64];
+		std::snprintf(buf, sizeof buf, "%.9g", static_cast<double>(v));
+
+		std::string out {buf};
+		auto e = out.find('e');
+		if (e != std::string::npos && out.size() - e == 4) {
+			out.insert(e + 2, 1, '0');
+		}
+		return out;
+	}
+
