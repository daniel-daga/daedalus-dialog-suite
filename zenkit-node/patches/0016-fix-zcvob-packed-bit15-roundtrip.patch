zCVob: round-trip bit 15 of the packed Gothic II flag word.

VirtualObject::load only decoded bits 0-14 of the second packed word in
`dataRaw` (ZenGin's declared bitfields end at isAmbient) and save always wrote
bit 15 as 0. ZenGin never assigns that bit either, so it carries whatever the
engine's memory held: 49 VObjects in the retail Gothic II NewWorld have it set.
It is now kept on VirtualObject::packed_reserved_bit so a re-saved world
reproduces the original bytes.

diff --git a/include/zenkit/vobs/VirtualObject.hh b/include/zenkit/vobs/VirtualObject.hh
index 8f65a5f..bf1ebc3 100644
--- a/include/zenkit/vobs/VirtualObject.hh
+++ b/include/zenkit/vobs/VirtualObject.hh
@@ -432,6 +432,15 @@ namespace zenkit {
 		/// \see https://zk.gothickit.dev/engine/objects/zCVob/#isambient
 		bool ambient = false;
 
+		/// \brief Bit 15 of the packed Gothic II flag word in `dataRaw`.
+		///
+		/// <p>ZenGin's declared bitfields end at #ambient (bit 14); bit 15 is never assigned, so retail worlds carry
+		/// whatever the engine's memory held when the VObject was saved. It has no meaning but is preserved so that
+		/// re-saving a world reproduces the original bytes.</p>
+		///
+		/// \note This property is only available in Gothic II.
+		bool packed_reserved_bit = false;
+
 		/// \brief Indicates the strength of the animation set through #anim_mode.
 		///
 		/// <p>Essentialy, this controls the strength of the wind to be animated using the given #anim_mode. This value
diff --git a/src/vobs/VirtualObject.cc b/src/vobs/VirtualObject.cc
index 4d2ba1c..39f3b12 100644
--- a/src/vobs/VirtualObject.cc
+++ b/src/vobs/VirtualObject.cc
@@ -121,6 +121,7 @@ namespace zenkit {
 				this->anim_mode = static_cast<AnimationType>((bit1 & 0b000000110000000u) >> 7u);
 				this->bias = static_cast<std::int32_t>((bit1 & 0b011111000000000u) >> 9u);
 				this->ambient = static_cast<bool>((bit1 & 0b100000000000000u) >> 14u);
+				this->packed_reserved_bit = static_cast<bool>((bit1 & 0b1000000000000000u) >> 15u);
 
 				this->anim_strength = bin->read_float();
 				this->far_clip_scale = bin->read_float();
@@ -254,6 +255,7 @@ namespace zenkit {
 				bit1 |= (static_cast<uint8_t>(this->anim_mode) & 3) << 7u;
 				bit1 |= (static_cast<uint8_t>(this->bias) & 0b11111) << 9u;
 				bit1 |= this->ambient << 14u;
+				bit1 |= this->packed_reserved_bit << 15u;
 
 				pw->write_ushort(bit1);
 				pw->write_float(this->anim_strength);
