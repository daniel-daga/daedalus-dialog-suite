+	static void pad_exponent(std::string& out) {
+		auto const e = out.find('e');
+		if (e != std::string::npos && out.size() - e == 4) {
+			out.insert(e + 2, 1, '0');
+		}
+	}
+
+	static std::string format_halfway(float v, std::uint64_t digits, int exponent) {
+		if (digits == 1'000'000'000) {
+			digits = 100'000'000;
+			++exponent;
+		}
+
+		std::array<char, 16> buf {};
+		auto const result = std::to_chars(buf.data(), buf.data() + buf.size(), digits);
+		std::string significand {buf.data(), static_cast<size_t>(result.ptr - buf.data())};
+		while (significand.size() > 1 && significand.back() == '0') significand.pop_back();
+
+		std::string out;
+		if (std::signbit(v)) out.push_back('-');
+		if (exponent < -4 || exponent >= 9) {
+			out.push_back(significand.front());
+			if (significand.size() > 1) {
+				out.push_back('.');
+				out.append(significand.substr(1));
+			}
+			out.push_back('e');
+			out.push_back(exponent < 0 ? '-' : '+');
+			std::array<char, 4> exponent_buf {};
+			auto const exp_result = std::to_chars(exponent_buf.data(), exponent_buf.data() + exponent_buf.size(), std::abs(exponent));
+			for (auto count = exp_result.ptr - exponent_buf.data(); count < 3; ++count) out.push_back('0');
+			out.append(exponent_buf.data(), static_cast<size_t>(exp_result.ptr - exponent_buf.data()));
+			return out;
+		}
+
+		auto const point = exponent + 1;
+		if (point <= 0) {
+			out.append("0.");
+			out.append(static_cast<size_t>(-point), '0');
+			out.append(significand);
+		} else if (static_cast<size_t>(point) >= significand.size()) {
+			out.append(significand);
+			out.append(static_cast<size_t>(point) - significand.size(), '0');
+		} else {
+			out.append(significand.substr(0, static_cast<size_t>(point)));
+			out.push_back('.');
+			out.append(significand.substr(static_cast<size_t>(point)));
+		}
+		return out;
+	}
+
