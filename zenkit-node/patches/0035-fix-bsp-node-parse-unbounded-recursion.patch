+	// The back child a node still owes, innermost first. This walk used to recurse
+	// once per child, which put a file-supplied flag bit in charge of the call
+	// stack; an explicit stack costs one heap allocation and cannot be overflowed.
+	struct _BspPendingChild {
+		std::int32_t parent;
+		bool leaf;
+	};
+
+	static void _parse_bsp_nodes(Read* in,
+	                             std::vector<BspNode>& nodes,
+	                             std::vector<std::uint64_t>& indices,
+	                             std::uint32_t version,
+	                             std::int32_t parent_index,
+	                             bool leaf = false) {
+		std::vector<_BspPendingChild> pending;
+
+		for (;;) {
+			std::uint64_t self_index = nodes.size();
+
+			auto& node = nodes.emplace_back();
+			node.parent_index = parent_index;
+			node.bbox.load(in);
+			node.polygon_index = in->read_uint();
+			node.polygon_count = in->read_uint();
+
+			bool descended = false;
+
+			if (leaf) {
+				indices.push_back(self_index);
+			} else {
+				auto flags = in->read_ubyte();
+
+				node.plane = {};
+				node.plane.w = in->read_float();
+				node.plane.x = in->read_float();
+				node.plane.y = in->read_float();
+				node.plane.z = in->read_float();
+
+				if (version == version_g1) {
+					node.lod = in->read_ubyte(); // "lod-flag"
+				}
+
+				// The front subtree is read first and in full, so the back child is owed
+				// until that subtree ends -- the order the two recursive calls had.
+				if ((flags & 0x02) != 0) {
+					pending.push_back({static_cast<std::int32_t>(self_index), (flags & 0x08) != 0});
+				}
+
+				if ((flags & 0x01) != 0) {
+					node.front_index = static_cast<std::int32_t>(nodes.size());
+					parent_index = static_cast<std::int32_t>(self_index);
+					leaf = (flags & 0x04) != 0;
+					descended = true;
+				}
+			}
+
+			if (descended) {
+				continue;
+			}
+
+			if (pending.empty()) {
+				return;
+			}
+
+			auto next = pending.back();
+			pending.pop_back();
+
+			// Written through the vector rather than through a reference: the whole
+			// front subtree has been read since this node was pushed, and every node
+			// it added may have reallocated `nodes`. The recursive version assigned
+			// `node.back_index` through a reference taken before that, which is a
+			// use-after-realloc whenever the tree outgrows the `reserve` the file's
+			// own node count asked for.
+			nodes[static_cast<std::size_t>(next.parent)].back_index = static_cast<std::int32_t>(nodes.size());
+			parent_index = next.parent;
+			leaf = next.leaf;
+		}
+	}
