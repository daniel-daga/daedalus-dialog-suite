{
  "name": "daedalus-dialog-editor",
  "version": "0.1.0",
  "description": "Visual dialog editor for Gothic 2 Daedalus scripting language",
  "main": "dist/main/main.js",
  "scripts": {
    "start": "electron .",
    "predev": "npm run build --prefix ../daedalus-parser && npm run build:ts --prefix ../daedalus-parser && npm run build --prefix ../zen-world",
    "prebuild": "npm run build --prefix ../zen-world",
    "dev": "npm run build:main && node scripts/dev.js",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "vite",
    "dev:browser": "vite",
    "dev:electron": "wait-on dist/main/main.js && electron . --enable-logging --no-sandbox",
    "build": "npm run build:main && npm run typecheck:renderer && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "typecheck:renderer": "tsc -p tsconfig.json --noEmit",
    "build:renderer": "vite build",
    "package": "electron-builder",
    "lint": "eslint .",
    "test": "jest",
    "test:mocked": "jest --config jest.mocked.config.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:stable:windows": "powershell -ExecutionPolicy Bypass -File scripts/run-jest-stable-windows.ps1",
    "test:matrix:windows": "powershell -ExecutionPolicy Bypass -File scripts/run-jest-stability-matrix.ps1",
    "test:actioncard": "jest ActionCard.test.tsx",
    "test:encoding": "npm run build:main && tsx tests/encoding.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "perf:fixture": "node scripts/generate-perf-fixture.js",
    "perf:bench": "node scripts/bench-merge.js"
  },
  "keywords": [
    "gothic",
    "modding",
    "dialog",
    "daedalus"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.gothicmodding.daedalusdialog",
    "productName": "Daedalus Dialog Editor",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "dist/shared/**/*",
      "node_modules/safe-buffer/**/*",
      "node_modules/safer-buffer/**/*",
      "package.json",
      "!node_modules/zenkit-node/vendor/**",
      "!node_modules/zenkit-node/vendor-build/**",
      "!node_modules/zenkit-node/build/Release/obj/**",
      "!node_modules/zenkit-node/build/Release/*.{iobj,ipdb,exp,lib}"
    ],
    "asarUnpack": [
      "**/node_modules/zenkit-node/**/*.node"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "linux": {
      "target": "AppImage",
      "category": "Development"
    },
    "win": {
      "target": "nsis"
    },
    "publish": null,
    "npmRebuild": false
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@hello-pangea/dnd": "^18.0.1",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.15.14",
    "@tanstack/react-query": "^5.28.4",
    "chardet": "^2.1.1",
    "chokidar": "^4.0.3",
    "daedalus-parser": "workspace:*",
    "iconv-lite": "^0.7.0",
    "immer": "^11.1.3",
    "monaco-editor": "0.55.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "react-virtualized-auto-sizer": "^1.0.24",
    "react-window": "^1.8.10",
    "safe-buffer": "^5.2.1",
    "safer-buffer": "^2.1.2",
    "three": "^0.180.0",
    "three-mesh-bvh": "^0.9.14",
    "tree-sitter": "^0.21.1",
    "zen-world": "workspace:*",
    "zenkit-node": "workspace:*",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@jest/globals": "^30.2.0",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chardet": "^0.8.3",
    "@types/node": "^24.0.0",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.23",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^14.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "npm-run-all": "^4.1.5",
    "tree-kill": "^1.2.2",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.2.6",
    "vite-plugin-electron": "^0.28.4",
    "wait-on": "^9.0.1"
  }
}
