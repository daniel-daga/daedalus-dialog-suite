exports[`generated output byte-identity (snapshot pin) pins the full generated source for MANA 1`] = `
"// ************************************************************
//			  	Teach MANA
// ************************************************************

var int Alrik_Merke_MANA;

INSTANCE DIA_Alrik_Teach (C_INFO)
{
	npc			= VLK_438_Alrik;
	nr			= 1;
	condition	= DIA_Alrik_Teach_Condition;
	information	= DIA_Alrik_Teach_Info;
	permanent	= TRUE;
	description	= "Trainier mich!";
};

FUNC INT DIA_Alrik_Teach_Condition()
{
	return TRUE;
};

FUNC VOID DIA_Alrik_Teach_Info()
{
	AI_Output (other, self, "DIA_Alrik_Teach_15_00"); //Trainier mich!

	Alrik_Merke_MANA = other.attribute[ATR_MANA_MAX];

	Info_ClearChoices	(DIA_Alrik_Teach);
	Info_AddChoice		(DIA_Alrik_Teach, DIALOG_BACK, DIA_Alrik_Teach_Back);
	Info_AddChoice		(DIA_Alrik_Teach, B_BuildLearnString(PRINT_LearnMANA1, B_GetLearnCostAttribute(other, ATR_MANA_MAX)), DIA_Alrik_Teach_MANA_1);
	Info_AddChoice		(DIA_Alrik_Teach, B_BuildLearnString(PRINT_LearnMANA5, B_GetLearnCostAttribute(other, ATR_MANA_MAX) * 5), DIA_Alrik_Teach_MANA_5);
};

FUNC VOID DIA_Alrik_Teach_Back()
{
	if (other.attribute[ATR_MANA_MAX] >= 30)
	{
		AI_Output (self, other, "DIA_Alrik_Teach_Back_09_00"); //Mehr kann ich dir nicht beibringen.
	}
	else if (other.attribute[ATR_MANA_MAX] > Alrik_Merke_MANA)
	{
		AI_Output (self, other, "DIA_Alrik_Teach_Back_09_01"); //Du machst Fortschritte. Weiter so!
	};

	Info_ClearChoices (DIA_Alrik_Teach);
};

FUNC VOID DIA_Alrik_Teach_MANA_1()
{
	B_TeachAttributePoints (self, other, ATR_MANA_MAX, 1, 30);

	Info_ClearChoices	(DIA_Alrik_Teach);
	Info_AddChoice		(DIA_Alrik_Teach, DIALOG_BACK, DIA_Alrik_Teach_Back);
	Info_AddChoice		(DIA_Alrik_Teach, B_BuildLearnString(PRINT_LearnMANA1, B_GetLearnCostAttribute(other, ATR_MANA_MAX)), DIA_Alrik_Teach_MANA_1);
	Info_AddChoice		(DIA_Alrik_Teach, B_BuildLearnString(PRINT_LearnMANA5, B_GetLearnCostAttribute(other, ATR_MANA_MAX) * 5), DIA_Alrik_Teach_MANA_5);
};

FUNC VOID DIA_Alrik_Teach_MANA_5()
{
	B_TeachAttributePoints (self, other, ATR_MANA_MAX, 5, 30);

	Info_ClearChoices	(DIA_Alrik_Teach);
	Info_AddChoice		(DIA_Alrik_Teach, DIALOG_BACK, DIA_Alrik_Teach_Back);
	Info_AddChoice		(DIA_Alrik_Teach, B_BuildLearnString(PRINT_LearnMANA1, B_GetLearnCostAttribute(other, ATR_MANA_MAX)), DIA_Alrik_Teach_MANA_1);
	Info_AddChoice		(DIA_Alrik_Teach, B_BuildLearnString(PRINT_LearnMANA5, B_GetLearnCostAttribute(other, ATR_MANA_MAX) * 5), DIA_Alrik_Teach_MANA_5);
};
"
`;

