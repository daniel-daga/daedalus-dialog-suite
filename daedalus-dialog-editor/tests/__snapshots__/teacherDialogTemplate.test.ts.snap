	Info_AddChoice		(DIA_Alrik_Teach, B_BuildLearnString(PRINT_LearnDEX5, B_GetLearnCostAttribute(other, ATR_DEXTERITY) * 5), DIA_Alrik_Teach_DEX_5);
};

