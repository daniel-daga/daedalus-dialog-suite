	{
		AI_Output (self, other, "DIA_Alrik_Teach_Back_09_00"); //Mehr kann ich dir nicht beibringen.
	}
	else if (other.attribute[ATR_DEXTERITY] > Alrik_Merke_DEX)
	{
		AI_Output (self, other, "DIA_Alrik_Teach_Back_09_01"); //Du machst Fortschritte. Weiter so!
	};

	Info_ClearChoices (DIA_Alrik_Teach);
};

