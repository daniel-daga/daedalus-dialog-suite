{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowJs": true,
    "types": ["jest", "node", "@testing-library/jest-dom", "@testing-library/jest-dom/jest-globals"]
  },
  "include": ["tests"],
  "exclude": ["tests/e2e", "tests/e2e-electron"]
}
