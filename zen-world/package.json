{
  "name": "zen-world",
  "version": "0.1.0",
  "private": true,
  "description": "Pure TypeScript domain for the ZenGin level editor — no React, MUI, Electron or native imports",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./coords": {
      "types": "./dist/cjs/coords/index.d.ts",
      "import": "./dist/esm/coords/index.js",
      "require": "./dist/cjs/coords/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json",
    "postinstall": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json",
    "test": "jest",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/jest": "^30.0.0",
    "eslint": "^9.36.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "typescript": "^5.4.3",
    "typescript-eslint": "^8.61.0"
  }
}
